+#[test]
+fn compaction_policy_is_model_scoped_on_a_shared_provider() {
+    let capabilities = ProviderCapabilities {
+        remote_compaction: RemoteCompactionSupport::V2,
+        ..Default::default()
+    };
+    for (model, expected) in [
+        ("gpt-6.1-sol", RemoteCompactionSupport::V2),
+        ("kimi-k3", RemoteCompactionSupport::Unsupported),
+        ("gpt-5.5", RemoteCompactionSupport::V2),
+        ("deepseek-v4", RemoteCompactionSupport::Unsupported),
+        ("gemini-3.5-flash", RemoteCompactionSupport::Unsupported),
+    ] {
+        assert_eq!(capabilities.remote_compaction_for_model(model), expected);
+    }
+    assert_eq!(capabilities.remote_compaction, RemoteCompactionSupport::V2);
+}
+
+#[test]
+fn compaction_policy_preserves_provider_restrictions() {
+    let capabilities = ProviderCapabilities::default();
+    assert_eq!(
+        capabilities.remote_compaction_for_model("gpt-6.1-sol"),
+        RemoteCompactionSupport::Unsupported,
+    );
+}
